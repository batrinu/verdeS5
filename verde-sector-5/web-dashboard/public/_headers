# Dev-phase cache policy: the SW, HTML entry, and manifest must always be
# revalidated so a new Pages deploy is discovered on the next navigation.
# Hashed assets under /assets/ stay immutable-cacheable.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=31536000, immutable
